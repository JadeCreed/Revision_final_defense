# Sample environment variables for this project.
# Copy this file to `.env` in the same folder and fill values for production.
# Do NOT commit a real `.env` with secrets.

# Development (dev.py uses SQLite by default; leave DB vars empty for dev)
DEBUG=True
SECRET_KEY=django-insecure-dev-placeholder
BREVO_SENDER_EMAIL=you@example.com
BREVO_API_KEY=changeme
BREVO_SENDER_NAME=name email placeholder

# Optional: comma-separated ALLOWED_HOSTS for production
#ALLOWED_HOSTS=example.com,www.example.com

# PostgreSQL (used by config.settings.prod)
POSTGRES_DB=capstone_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
